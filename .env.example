# Copy to .env (gitignored). docker compose reads it automatically.
# OpenAI-compatible LLM gateway. m3u512gb.local does not resolve inside Docker; use the Tailscale name.
DAASH_LLM_ENDPOINT=http://m3u512gb.tail391a32.ts.net:12345
# Bearer token for the gateway (required by the m3u512gb gateway; never commit it).
DAASH_LLM_API_KEY=
# Optional: set to false to start the engine container without it driving any agents.
# DAASH_ENGINE_ENABLED=true

# Max concurrent HTTP calls per model (one LLM server slows to minutes above about 4).
DAASH_LLM_MAX_CONCURRENCY=4
# Per-model overrides as a JSON object, e.g. {"amazing": 1}. Bad JSON is ignored with a warning.
DAASH_LLM_MODEL_CONCURRENCY={}

# --- Authentication and runners (0.3) ---
# Bearer token for the admin API and DAASHboard. Empty = open (fine on 127.0.0.1 only).
# REQUIRED if you publish the coordinator beyond this machine (see DAASH_BIND_ADDR).
DAASH_API_TOKEN=
# If set, the coordinator creates a runner named "local-runner" with this token at start, so a
# runner container can start without a manual "Add runner" step. Pick a long random string.
DAASH_RUNNER_BOOTSTRAP_TOKEN=
# Address the coordinator port (8000) is published on. Default 127.0.0.1 (this machine only);
# use 0.0.0.0 or your Tailscale IP so runners on other devices can connect.
# DAASH_BIND_ADDR=127.0.0.1
