# Copy to .env (gitignored). docker compose reads it automatically.
# OpenAI-compatible LLM gateway. m3u512gb.local does not resolve inside Docker; use the Tailscale name.
DAASH_LLM_ENDPOINT=http://m3u512gb.tail391a32.ts.net:12345
# Bearer token for the gateway (required by the m3u512gb gateway; never commit it).
DAASH_LLM_API_KEY=
# Optional: set to false to start the engine container without it driving any agents.
# DAASH_ENGINE_ENABLED=true

# Max concurrent HTTP calls per model (one LLM server slows to minutes above about 4).
DAASH_LLM_MAX_CONCURRENCY=4
# Per-model overrides as a JSON object, e.g. {"amazing": 1}. Bad JSON is ignored with a warning.
DAASH_LLM_MODEL_CONCURRENCY={}

# --- Authentication and runners (0.3; docs/DESIGN-0.3.md, docs/RUNNER.md) ---
# Bearer token for the admin API and DAASHboard. Empty = open (fine on 127.0.0.1 only).
# REQUIRED if you publish the coordinator beyond this machine (see DAASH_BIND_ADDR).
DAASH_API_TOKEN=
# Runner token shared by the coordinator (it creates a runner named "local-runner" with it at
# start) and the compose runner (`docker compose --profile runner up --build -d runner`).
# Use e.g.: daash_rt_$(openssl rand -hex 24)
DAASH_RUNNER_BOOTSTRAP_TOKEN=
# Jobs the compose runner runs at once.
DAASH_RUNNER_MAX_JOBS=2
# Address the coordinator port (8000) is published on. Default 127.0.0.1 (this machine only);
# use 0.0.0.0 or your Tailscale IP so runners on other devices can connect.
# DAASH_BIND_ADDR=127.0.0.1

# --- Agent port and connected agents (0.4; docs/DESIGN-0.4.md, docs/AGENT-HOSTS.md) ---
# Address the agent port (8001) is published on. It serves only /health, /mcp and /runner/*, never DAASHboard
# or the admin API. Default 127.0.0.1; use 0.0.0.0 or a Tailscale IP so agents on other machines can reach it.
# DAASH_AGENT_BIND_ADDR=127.0.0.1
# The address other machines use for the agent port, e.g. http://my-mac.my-tailnet.ts.net:8001. It goes into the
# owner's approval step and the agent-host install command; agent hosts need it.
# DAASH_AGENT_PUBLIC_URL=
# Hosts that discovery probes for OpenClaw (18789) and Hermes (8642) agents, comma-separated. Docker Desktop cannot
# reach LAN addresses but can reach Tailscale names: scripts/tailnet-hosts.sh prints a value for this.
# DAASH_DISCOVERY_HOSTS=
# Private CIDRs no larger than /24 whose every address is probed too, e.g. 192.168.1.0/24.
# DAASH_DISCOVERY_SUBNETS=
