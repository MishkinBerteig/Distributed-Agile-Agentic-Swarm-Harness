# DAASH runner image (docs/DESIGN-0.3.md section 7): python3 + node + the three agent CLIs.
# Running the CLIs here keeps agent-executed code off the host.
# Two stages: `fake-only` (python only, no node/npm; used by the e2e tier with the `fake`
# harness) and `full` (the default, last stage).
FROM python:3.12-slim-bookworm AS fake-only
COPY daash_runner /opt/daash/daash_runner
COPY runner/runner.e2e.json /opt/daash/runner.e2e.json
RUN useradd --create-home --shell /bin/bash runner \
    && mkdir -p /work && chown runner:runner /work
USER runner
ENV HOME=/home/runner \
    PYTHONPATH=/opt/daash \
    PYTHONUNBUFFERED=1 \
    DAASH_RUNNER_CONFIG=/opt/daash/runner.e2e.json \
    DAASH_RUNNER_WORKDIR=/work
WORKDIR /work
ENTRYPOINT ["python3", "-m", "daash_runner"]

FROM node:22-bookworm-slim AS full

RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 ca-certificates git ripgrep \
    && rm -rf /var/lib/apt/lists/*

# Versions match the ones verified in docs/RUNNER.md.
RUN npm install -g --no-audit --no-fund \
    @gitlawb/openclaude@0.31.0 \
    @anthropic-ai/claude-code@2.1.319 \
    @openai/codex@0.160.0 \
    && npm cache clean --force

COPY daash_runner /opt/daash/daash_runner
COPY runner/runner.docker.json /opt/daash/runner.docker.json

# Non-root user (Claude Code refuses bypass-permissions as root).
RUN useradd --create-home --shell /bin/bash runner \
    && mkdir -p /work && chown runner:runner /work
USER runner
ENV HOME=/home/runner \
    PYTHONPATH=/opt/daash \
    PYTHONUNBUFFERED=1 \
    DAASH_RUNNER_CONFIG=/opt/daash/runner.docker.json \
    DAASH_RUNNER_WORKDIR=/work
WORKDIR /work
ENTRYPOINT ["python3", "-m", "daash_runner"]
