# DAASH runner image (docs/DESIGN-0.3.md section 7, docs/DESIGN-0.4.md section 4.5): python3 + node +
# the agent CLIs. Running the CLIs here keeps agent-executed code off the host.
# Two stages: `fake-only` (python only, no node/npm; used by the e2e tier with the `fake`
# harness) and `full` (the default, last stage).
FROM python:3.12-slim-bookworm AS fake-only
COPY daash_runner /opt/daash/daash_runner
COPY runner/runner.e2e.json /opt/daash/runner.e2e.json
RUN useradd --create-home --shell /bin/bash runner \
    && mkdir -p /work && chown runner:runner /work
USER runner
ENV HOME=/home/runner \
    PYTHONPATH=/opt/daash \
    PYTHONUNBUFFERED=1 \
    DAASH_RUNNER_CONFIG=/opt/daash/runner.e2e.json \
    DAASH_RUNNER_WORKDIR=/work
WORKDIR /work
ENTRYPOINT ["python3", "-m", "daash_runner"]

# Node 24: OpenClaw needs node >= 24.16 (the other CLIs need >= 22).
FROM node:24-bookworm-slim AS full

# curl, xz-utils and libatomic1 are for the Hermes Agent installer below.
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 ca-certificates git ripgrep curl xz-utils \
       libatomic1 procps tini \
    && rm -rf /var/lib/apt/lists/*

# Versions match the ones verified in docs/RUNNER.md.
RUN npm install -g --no-audit --no-fund \
    @gitlawb/openclaude@0.31.0 \
    @anthropic-ai/claude-code@2.1.319 \
    @openai/codex@0.160.0 \
    openclaw@2026.11.3 \
    && npm cache clean --force

# Non-root user (Claude Code refuses bypass-permissions as root).
RUN useradd --create-home --shell /bin/bash runner \
    && mkdir -p /work && chown runner:runner /work
USER runner
ENV HOME=/home/runner

# Hermes Agent v0.23.1, installed by its official installer pinned to the release commit (the script
# itself is fetched at that commit; it pins uv and hash-verifies the Python dependencies through
# uv.lock). Default layout, owned by the runner user: code in ~/.hermes/hermes-agent, its own Python
# and tools in ~/.hermes/tools, the `hermes` launcher in ~/.local/bin. No browser, no computer-use
# driver. Jobs never use ~/.hermes as their home: each job gets its own HERMES_HOME (adapters.py).
ARG HERMES_COMMIT=3b421578588243f920886e6fe79a6faa87ea026e
RUN curl -fsSL -o /home/runner/hermes-install.sh \
       "https://raw.githubusercontent.com/NousResearch/hermes-agent/${HERMES_COMMIT}/scripts/install.sh" \
    && bash /home/runner/hermes-install.sh --branch main --commit "${HERMES_COMMIT}" \
       --non-interactive --skip-browser --skip-computer-use \
    && rm -f /home/runner/hermes-install.sh \
    && /home/runner/.local/bin/hermes --version

COPY daash_runner /opt/daash/daash_runner
COPY runner/runner.docker.json /opt/daash/runner.docker.json

ENV PATH=/home/runner/.local/bin:${PATH} \
    PYTHONPATH=/opt/daash \
    PYTHONUNBUFFERED=1 \
    DAASH_RUNNER_CONFIG=/opt/daash/runner.docker.json \
    DAASH_RUNNER_WORKDIR=/work
WORKDIR /work
# tini as PID 1 reaps what the CLIs leave behind (a Hermes gateway double-forks).
ENTRYPOINT ["/usr/bin/tini", "--", "python3", "-m", "daash_runner"]
